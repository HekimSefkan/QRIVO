# QRIVO Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit a real .env file to version control.

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=QRIVO
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=en

# ─── Database ─────────────────────────────────────────────────────────────────
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qrivo
DB_USERNAME=root
DB_PASSWORD=

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=file
LOG_LEVEL=debug
LOG_PATH=
LOG_MAX_FILES=30

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all
CORS_ALLOWED_ORIGINS=*

# ─── Authentication ───────────────────────────────────────────────────────────
# Access token lifetime in seconds (default: 3600 = 1 hour)
AUTH_ACCESS_TOKEN_TTL=3600
# Refresh token lifetime in seconds (default: 2592000 = 30 days)
AUTH_REFRESH_TOKEN_TTL=2592000
# Rate limiting: max failed login attempts per IP in the window
AUTH_RATE_LIMIT_MAX_IP=20
# Rate limiting: max failed attempts per email in the window
AUTH_RATE_LIMIT_MAX_EMAIL=10
# Rate limiting: time window in seconds (default: 900 = 15 minutes)
AUTH_RATE_LIMIT_WINDOW=900

