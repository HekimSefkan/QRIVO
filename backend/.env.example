# QRIVO Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit a real .env file to version control.

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=QRIVO
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=en

# ─── Database ─────────────────────────────────────────────────────────────────
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qrivo
DB_USERNAME=root
DB_PASSWORD=

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=file
LOG_LEVEL=debug
LOG_PATH=
LOG_MAX_FILES=30

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all
CORS_ALLOWED_ORIGINS=*

# ─── Authentication ───────────────────────────────────────────────────────────
# Access token lifetime in seconds (default: 3600 = 1 hour)
AUTH_ACCESS_TOKEN_TTL=3600
# Refresh token lifetime in seconds (default: 2592000 = 30 days)
AUTH_REFRESH_TOKEN_TTL=2592000
# Rate limiting: max failed login attempts per IP in the window
AUTH_RATE_LIMIT_MAX_IP=20
# Rate limiting: max failed attempts per email in the window
AUTH_RATE_LIMIT_MAX_EMAIL=10
# Rate limiting: time window in seconds (default: 900 = 15 minutes)
AUTH_RATE_LIMIT_WINDOW=900

# ─── Dynamic QR (attendance) ─────────────────────────────────────────────────
# How long a generated QR payload stays valid (seconds). Short-lived by design.
QR_TTL_SECONDS=30
# How often the teacher screen refreshes the QR (defaults to QR_TTL_SECONDS)
QR_REFRESH_SECONDS=30
# Allowance for client/server clock skew when checking QR age (seconds)
QR_CLOCK_SKEW_SECONDS=5

# ─── Challenge-response attendance ───────────────────────────────────────────
# Challenge lifetime (seconds) — the mobile must submit its response in this window
ATTENDANCE_CHALLENGE_TTL_SECONDS=120
# Rate limiting: max challenge requests per (student, session) in the window
ATTENDANCE_CHALLENGE_MAX_PER_WINDOW=10
ATTENDANCE_CHALLENGE_WINDOW_SECONDS=300
# Risk scoring (basic in Phase 12; full engine + system_settings in Phase 19)
ATTENDANCE_RISK_SOFT_RETRY=6
ATTENDANCE_RISK_HIGH_RETRY=9
ATTENDANCE_RISK_RETRY_WINDOW=300

# ─── Device & session security (Phase 18) ────────────────────────────────────
# More concurrent active sessions than this for one user raises a SUSPICIOUS_DEVICE event
SECURITY_MAX_ACTIVE_SESSIONS=5
# When true, a request whose device fingerprint != the one recorded at issue time is rejected (401).
# Default false: the mismatch is always logged + fed to risk scoring, but not fatal.
SECURITY_ENFORCE_DEVICE_BINDING=false
# Idle-session timeout in seconds (0 = disabled). Enforced in addition to the absolute expiry.
SECURITY_SESSION_IDLE_TIMEOUT=0

