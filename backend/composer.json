{
    "name": "qrivo/backend",
    "description": "QRIVO — Secure QR-Based University Attendance System Backend",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.7",
        "nikic/fast-route": "^1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "QRIVO\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QRIVO\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
