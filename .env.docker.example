# QRIVO — docker-compose environment template (LOCAL DEVELOPMENT ONLY).
#
#   cp .env.docker.example .env
#   # then edit the two values marked CHANGE ME below
#   docker compose up -d
#
# docker-compose automatically reads ./.env for ${...} interpolation, and passes
# these values into the `api` container. The root ./.env is gitignored — never
# commit a filled-in copy.
#
# NOTE: this file configures the DOCKER path only. For the native/Laragon path
# the backend reads backend/.env instead (see backend/.env.example).

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
# Host port the API is published on. Change if 8000 is taken.
APP_PORT=8000

# ─── Database ─────────────────────────────────────────────────────────────────
DB_DATABASE=qrivo
DB_USERNAME=root
# CHANGE ME — the MySQL root password for your local container. Any value works;
# it never leaves your machine. Compose refuses to start if this is empty.
DB_PASSWORD=
# Host port the database is published on. Change if 3306 is taken.
DB_PORT=3306

# ─── Logging / CORS ───────────────────────────────────────────────────────────
LOG_LEVEL=debug
# '*' is fine locally. Production must list explicit origins (see OQ-007).
CORS_ALLOWED_ORIGINS=*

# ─── Demo seed ────────────────────────────────────────────────────────────────
# CHANGE ME — password given to every account created by scripts/seed.php.
# Minimum 8 characters. Local demo credentials only; seed.php refuses to run
# unless APP_ENV=local.
SEED_DEFAULT_PASSWORD=
